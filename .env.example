# ==============================================================================
# Finova AI — Environment Configuration Template
# Copy this file to .env and adjust values for your local environment:
#   Copy-Item .env.example .env (Windows PowerShell)
# ==============================================================================

# Application Metadata
APP_NAME="Finova AI"
APP_ENV=development
DEBUG=True
APP_VERSION=0.1.0

# Server Configuration
HOST=127.0.0.1
PORT=8000

# Logging
# Supported levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/finova.log

# Database
# SQLite connection URL for local development (no external database server required)
DATABASE_URL=sqlite:///./finova.db

# SEC EDGAR API Configuration
# IMPORTANT: The SEC requires all programmatic requests to declare a User-Agent in the format:
#   User-Agent: Sample Company Name AdminContact@<sample company domain>.com
# Replace the placeholder below with your real application/researcher name and contact email
# before initiating SEC EDGAR retrieval in subsequent sessions.
SEC_USER_AGENT="FinovaAI-Research/0.1.0 (contact@example.com)"

