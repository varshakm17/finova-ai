# ==============================================================================
# Finova AI — Environment Configuration Template
# Copy this file to .env and adjust values for your local environment:
#   copy .env.example .env (Windows PowerShell)
#   cp .env.example .env (Linux / macOS)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Application Metadata
# ------------------------------------------------------------------------------
APP_NAME="Finova AI"
APP_ENV=development
DEBUG=True
APP_VERSION=0.1.0

# ------------------------------------------------------------------------------
# 2. Server Binding & Security
# ------------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:3000
CORS_ALLOW_CREDENTIALS=True
DOCS_ENABLED=True
MAX_REQUEST_BODY_BYTES=10485760

# ------------------------------------------------------------------------------
# 3. Frontend Connection Settings
# ------------------------------------------------------------------------------
# Leave empty for automatic local resolution (http://127.0.0.1:8000/api/v1).
# In Docker, set to: BACKEND_API_URL=http://backend:8000/api/v1
BACKEND_API_URL=

# ------------------------------------------------------------------------------
# 4. Logging Configuration
# ------------------------------------------------------------------------------
# Supported levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/finova.log

# ------------------------------------------------------------------------------
# 5. Database Configuration (SQLite)
# ------------------------------------------------------------------------------
# Local SQLite persistence (Zero external database infrastructure required)
DATABASE_URL=sqlite:///./finova.db
DATABASE_WAL_MODE=True
DATABASE_BUSY_TIMEOUT_MS=30000

# ------------------------------------------------------------------------------
# 6. SEC EDGAR Regulatory Fair-Access Compliance
# ------------------------------------------------------------------------------
# SEC EDGAR requires a declared User-Agent with valid researcher email:
# Format: ApplicationName AdminContact@domain.com
# Example: SEC_USER_AGENT=FinovaAI-Research/1.0 (researcher@myorganization.org)
# NOTE: Do NOT use placeholder domains like example.com or domain.com.
SEC_USER_AGENT=

FILINGS_STORAGE_DIR=datasets/filings
MAX_DOCUMENT_SIZE_BYTES=26214400
CHUNK_TARGET_SIZE=3500
CHUNK_OVERLAP=400

# ------------------------------------------------------------------------------
# 7. Dense Semantic Retrieval (FAISS + SentenceTransformers)
# ------------------------------------------------------------------------------
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32
EMBEDDING_INDEX_DIR=datasets/indexes
EMBEDDING_BACKEND=auto

# ------------------------------------------------------------------------------
# 8. Sparse Lexical Retrieval (BM25Okapi) & Hybrid Search
# ------------------------------------------------------------------------------
BM25_INDEX_DIR=datasets/indexes/bm25
BM25_K1=1.5
BM25_B=0.75
BM25_TOKENIZER_VERSION=1.0.0
HYBRID_RRF_CONSTANT=60

# ------------------------------------------------------------------------------
# 9. Cross-Encoder Reranker
# ------------------------------------------------------------------------------
RERANKER_ENABLED=True
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_DEVICE=cpu
RERANKER_BATCH_SIZE=16
RERANKER_CANDIDATE_COUNT=25

# ------------------------------------------------------------------------------
# 10. Local LLM Integration (Ollama)
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
LLM_REQUEST_TIMEOUT=60.0
LLM_PROVIDER=ollama

# ------------------------------------------------------------------------------
# 11. Claim-Level Anti-Hallucination Verification
# ------------------------------------------------------------------------------
VERIFICATION_ENABLED=True
VERIFICATION_NUMERIC_TOLERANCE_PCT=1.0
VERIFICATION_STRICT_PERIODS=True
VERIFICATION_SEMANTIC_OVERLAP_THRESHOLD=0.25
VERIFICATION_MAX_REGENERATION_ATTEMPTS=1
VERIFICATION_ENABLE_REGENERATION=False
VERIFICATION_VERSION=0.1.0
