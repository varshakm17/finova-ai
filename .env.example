# ==============================================================================
# Finova AI — Environment Configuration Template
# Copy this file to .env and adjust values for your local environment:
#   Copy-Item .env.example .env (Windows PowerShell)
#   cp .env.example .env (Linux / macOS / Docker)
# ==============================================================================

# Core Application Metadata
APP_NAME="Finova AI"
APP_ENV=development
DEBUG=True
APP_VERSION=0.1.0

# Server Binding
HOST=127.0.0.1
PORT=8000
API_V1_PREFIX=/api/v1

# Logging
# Supported levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/finova.log

# Database Configuration
# Local SQLite persistence (Zero external database required)
DATABASE_URL=sqlite:///./finova.db

# SEC EDGAR Regulatory Fair-Access Compliance
# SEC EDGAR requires a declared User-Agent with valid researcher email:
# Format: ApplicationName AdminContact@domain.com
SEC_USER_AGENT="FinovaAI-Research/0.1.0 (contact@example.com)"
FILINGS_STORAGE_DIR=datasets/filings
MAX_DOCUMENT_SIZE_BYTES=26214400
CHUNK_TARGET_SIZE=3500
CHUNK_OVERLAP=400

# Dense Semantic Retrieval (FAISS + SentenceTransformers)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32
VECTOR_INDEX_PATH=datasets/indexes/faiss_index.bin
VECTOR_METADATA_PATH=datasets/indexes/faiss_metadata.json

# Sparse Lexical Retrieval (BM25Okapi)
BM25_INDEX_DIR=datasets/indexes/bm25
BM25_K1=1.5
BM25_B=0.75
BM25_TOKENIZER_VERSION=1.0.0

# Cross-Encoder Reranker
RERANKER_ENABLED=True
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_DEVICE=cpu
RERANKER_BATCH_SIZE=16
RERANKER_CANDIDATE_COUNT=10

# Local LLM Integration (Ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=60.0
LLM_PROVIDER_TYPE=ollama

# Claim-Level Anti-Hallucination Verification
VERIFICATION_ENABLED=True
VERIFICATION_NUMERIC_TOLERANCE_PCT=1.0
VERIFICATION_STRICT_PERIODS=True
VERIFICATION_SEMANTIC_OVERLAP_THRESHOLD=0.25
VERIFICATION_MAX_REGENERATION_ATTEMPTS=1
VERIFICATION_ENABLE_REGENERATION=False
VERIFICATION_VERSION=0.1.0
