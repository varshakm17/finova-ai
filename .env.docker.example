# ==============================================================================
# Finova AI — Docker Compose Environment Configuration Template
# Copy this file to .env before starting docker-compose:
#   copy .env.docker.example .env (Windows PowerShell)
#   cp .env.docker.example .env (Linux / macOS)
# ==============================================================================

# Core Application Settings
APP_ENV=production
DEBUG=False

# Host Port Bindings (Published Ports on Host Machine)
# Map host ports to containers (backend internal: 8000, frontend internal: 8501)
PORT=8000
FRONTEND_PORT=8501

# SEC EDGAR Regulatory Fair-Access Compliance
# Mandatory: Supply your actual institutional or researcher name and contact email.
# The SEC fair-access policy requires the format: 'ApplicationName AdminContact@domain.com'.
# Example: SEC_USER_AGENT=FinovaAI-Research/1.0 (researcher@myorganization.org)
SEC_USER_AGENT=

# Backend CORS Whitelist
# Comma-separated list of permitted web origins for frontend access.
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://frontend:8501
CORS_ALLOW_CREDENTIALS=True
DOCS_ENABLED=True

# Frontend Backend API Endpoint
# Inside Docker, the frontend accesses the backend via Docker network service name:
BACKEND_API_URL=http://backend:8000/api/v1

# Optional Local LLM (Ollama)
# When Ollama runs on the host machine outside Docker, use host.docker.internal:
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b
